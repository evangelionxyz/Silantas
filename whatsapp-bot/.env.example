# Port server WhatsApp Bot
PORT=3000

# Durasi hening setelah admin membalas manual (dalam satuan jam)
# Default: 4 jam
ADMIN_COOLDOWN_HOURS=4

# Waktu debounce untuk merangkum pesan beruntun dari pengguna (milidetik)
DEBOUNCE_MS=1500

# URL Backend Silantas (opsional jika mengintegrasikan rekapan otomatis)
SILANTAS_BACKEND_URL=http://localhost:8000
