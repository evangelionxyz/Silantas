# Web frontend
FRONTEND_WEB_URL=https://silantas.vercel.app/

# Backend API Configuration
HOST=localhost
PORT=8000
JWT_SECRET=your-jwt-secret-replace-in-production
VITE_API_BASE_URL=http://localhost:8000
MINI_REDIS_ENABLED=true

# Database (PostgreSQL)
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=1234
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=postgres
POSTGRESQL_DATABASE_URL=

# WhatsApp Bot Configuration
# Note: In docker-compose, PORT=3000 is automatically set for the bot container
ADMIN_COOLDOWN_HOURS=4
DEBOUNCE_MS=1500
SILANTAS_BACKEND_URL=http://silantas-api:8000
